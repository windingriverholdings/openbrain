[Unit]
Description=OpenBrain Web UI (127.0.0.1:10203)
Documentation=https://github.com/windingriverholdings/openbrain
# Phase 3.5 (OB-066): system unit, converged with openknowledge's model.
# Postgres is a LOCAL system unit on this host (OPENBRAIN_DB_HOST defaults
# to localhost), so ordering against it is meaningful here, unlike under
# the old --user unit where a user unit cannot order against a system unit
# at all. network-online.target covers Ollama, Telegram/Slack APIs, and the
# OAuth issuer, which are all reached over the network.
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=craig8

# Not the repo: no openbrain-web code path resolves a relative path against
# WorkingDirectory (storage is Postgres; the one thing it writes,
# upload-staging, uses an absolute OPENBRAIN_INGEST_DIR from the env file).
WorkingDirectory=/home/craig8

# Config lives in /etc, out of git, mode 0600 (Phase 3.5 config relocation).
EnvironmentFile=/etc/openbrain/openbrain.env

# Released binary path (Phase 2 installer's target), not the repo bin/.
ExecStart=/usr/local/bin/openbrain-web

Environment=OPENBRAIN_WEB_HOST=127.0.0.1
Environment=OPENBRAIN_WEB_PORT=10203

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openbrain-web

# Harden the service
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# openbrain-web stages document uploads under
# <OPENBRAIN_INGEST_DIR>/.uploads/ (cmd/openbrain-web/handler_ingest.go,
# stageUpload). The repo checkout path is dropped: nothing under it is
# written by this service anymore.
ReadWritePaths=/home/craig8/.config/openbrain/ingest

# TODO(tailscale): When exposing over Tailscale, change OPENBRAIN_WEB_HOST
#                  to 0.0.0.0 (or your Tailscale IP) and add Caddy in front
#                  for TLS. Also add: AmbientCapabilities=CAP_NET_BIND_SERVICE
#                  if binding to port 443 directly.

[Install]
WantedBy=multi-user.target
