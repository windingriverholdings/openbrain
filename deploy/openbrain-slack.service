[Unit]
Description=OpenBrain Slack Bot
Documentation=https://github.com/windingriverholdings/openbrain
# Phase 3.5 (OB-066): system unit. Postgres is a local system unit on this
# host, so ordering against it here is meaningful (unlike under --user).
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=craig8

# Not the repo: openbrain-slack writes nothing to disk (confirmed by
# reading cmd/openbrain-slack: no os.WriteFile/os.Create/os.MkdirAll/
# os.Rename calls in that package).
WorkingDirectory=/home/craig8

EnvironmentFile=/etc/openbrain/openbrain.env

ExecStart=/usr/local/bin/openbrain-slack

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openbrain-slack

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# No ReadWritePaths: openbrain-slack writes nothing under the repo or
# anywhere else on disk (see the WorkingDirectory comment above).

[Install]
WantedBy=multi-user.target
