# OpenBrain Environment Configuration
# Copy to .env and fill in values

# ── Database ─────────────────────────────────────────────
OPENBRAIN_DB_HOST=localhost
OPENBRAIN_DB_PORT=5432
OPENBRAIN_DB_NAME=openbrain
OPENBRAIN_DB_USER=openbrain
OPENBRAIN_DB_PASSWORD=change_me

# ── Embedding ─────────────────────────────────────────────
# Default: nomic-embed-text (768 dims, 8192 token context, local via Ollama)
OPENBRAIN_EMBEDDING_MODEL=nomic-embed-text
OPENBRAIN_EMBEDDING_DIM=768

# ── Retrieval ─────────────────────────────────────────────
OPENBRAIN_SEARCH_TOP_K=10
# Fast semantic search can return more results without the hybrid query cost.
OPENBRAIN_SEARCH_FAST_TOP_K=20
OPENBRAIN_SEARCH_SCORE_THRESHOLD=0.35
# Optional local model for assisted search. If empty, the fast extraction
# model, then the primary extraction model, is used.
# OPENBRAIN_SEARCH_ASSISTED_MODEL=llama3.2:1b
# Maximum time allowed for AI Search planning and read-only retrieval.
# OPENBRAIN_SEARCH_AGENT_TIMEOUT=30s
# Number of literal results supplied to the model as context before expansion.
# OPENBRAIN_SEARCH_PROBE_TOP_K=10

# ── Telegram Bot (work branch) ────────────────────────────
# Create a bot via @BotFather on Telegram
OPENBRAIN_TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get your user ID from @userinfobot on Telegram
OPENBRAIN_TELEGRAM_ALLOWED_USER_ID=your_numeric_user_id

# ── Slack Bot ─────────────────────────────────────────────
# Socket Mode — no public URL required, runs fully local
# Bot token: OAuth & Permissions → Bot Token (xoxb-...)
OPENBRAIN_SLACK_BOT_TOKEN=xoxb-your-bot-token
# App token: Socket Mode → App-Level Token with connections:write scope (xapp-...)
OPENBRAIN_SLACK_APP_TOKEN=xapp-your-app-token
# Your Slack user ID: click your name → Profile → ⋮ → Copy member ID (e.g. U012AB3CD)
OPENBRAIN_SLACK_ALLOWED_USER_ID=U012AB3CD

# ── Web UI ────────────────────────────────────────────────
# Local only — accessible at http://mybrain.local:10203
OPENBRAIN_WEB_HOST=127.0.0.1
OPENBRAIN_WEB_PORT=10203
# TODO(tailscale): Change WEB_HOST to 0.0.0.0 when exposing via Tailscale + Caddy

# ── MCP HTTP Transport ───────────────────────────────────
# Enable the HTTP-based MCP transport (Streamable HTTP + SSE)
OPENBRAIN_MCP_HTTP_ENABLED=false
# Bearer token for MCP HTTP authentication (min 32 chars)
# OPENBRAIN_MCP_AUTH_TOKEN=your-secret-token-at-least-32-chars
# Comma-separated Host-header allowlist for /mcp and /sse, replacing mcp-go's
# built-in loopback-only DNS-rebinding protection so a reverse proxy (e.g.
# cloudflared) forwarding the public hostname unchanged is not rejected.
# Loopback (localhost, 127.0.0.1, ::1) is always permitted in addition to
# this list. Defaults to the deployed public host; override per deployment.
# OPENBRAIN_MCP_ALLOWED_HOSTS=openbrain.wr-s.net

# ── OAuth 2.0 (Claude.ai MCP Connector) ─────────────────
# Required for Claude.ai's remote MCP connector.
# Claude.ai sends client_id + client_secret to obtain a bearer token.
# OPENBRAIN_OAUTH_CLIENT_ID=your-oauth-client-id
# OPENBRAIN_OAUTH_CLIENT_SECRET=your-oauth-client-secret-min-32-chars
# Issuer URL (must match your public-facing domain)
# OPENBRAIN_OAUTH_ISSUER=https://openbrain.example.com

# ── Brain Visualization ──────────────────────────────────
# Path to build-brain-viz.py; empty disables the rebuild endpoint.
# OPENBRAIN_VIZ_SCRIPT_PATH=/path/to/scripts/build-brain-viz.py
# Path where brain.json (and its <path>.progress.json sidecar) is written
# and served from disk. Under the Phase 3.5 system-unit deploy
# (deploy/openbrain-web.service), this MUST be
# /var/lib/openbrain/brain.json: that unit grants write access to
# /var/lib/openbrain via StateDirectory=openbrain, and no other path is
# writable under its ProtectSystem=strict/ProtectHome=read-only hardening.
# For a local, non-systemd dev run, any writable path is fine.
# OPENBRAIN_VIZ_OUTPUT_PATH=/var/lib/openbrain/brain.json
# Max age of brain.json before /api/rebuild-viz/status reports it stale and
# the frontend triggers a background refresh. Default 24h when unset. Set to
# an empty string or 0 to disable staleness (missing-file-only trigger).
# OPENBRAIN_VIZ_TTL=24h
# Python interpreter used to run OPENBRAIN_VIZ_SCRIPT_PATH. Defaults to
# "python3" resolved off the service's own PATH, which typically has none of
# the viz pipeline's dependencies. Point this at the venv python that has
# scripts/requirements-viz.txt installed, for example
# /path/to/venv/bin/python3.
# OPENBRAIN_VIZ_PYTHON=/path/to/venv/bin/python3

# ── LLM Extraction (Phase 3) ────────────────────────────
# Provider: "ollama" (local), "claude" (API), or "none" (disabled)
OPENBRAIN_EXTRACT_PROVIDER=ollama
# Primary model: used for long/complex text and corrections
OPENBRAIN_EXTRACT_MODEL=gemma3
# Fast model: used for short/simple text (leave empty to always use primary)
OPENBRAIN_EXTRACT_MODEL_FAST=llama3.2:1b
# Char threshold: text longer than this uses the primary model (default 500)
OPENBRAIN_EXTRACT_FAST_THRESHOLD=500
# Ollama server URL (default: http://localhost:11434)
OPENBRAIN_OLLAMA_BASE_URL=http://localhost:11434
# Anthropic API key (only needed for claude provider)
# OPENBRAIN_ANTHROPIC_API_KEY=sk-ant-...
